# Required. The SQLite database is created when this file does not exist.
DB_PATH=./charsibot.db

# Optional server configuration.
PORT=8081
HOST=0.0.0.0
SHUTDOWN_TIMEOUT=30

# Set this to the exact URL used to access the app from another device, including
# the scheme and port (for example, http://192.168.1.50:8081).
# ORIGIN=http://192.168.1.50:8081

# Local development and CI only. Production must set this to false and provide all four
# Twitch credentials below. This prevents a production deployment from starting without a bot.
TWITCH_MOCK_MODE=true

# Required when TWITCH_MOCK_MODE is false.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_USER_ID=
TWITCH_CHANNEL_USER_ID=

# Required only when using the OAuth pages.
TWITCH_OAUTH_REDIRECT_URI=
