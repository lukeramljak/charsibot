# Required. The SQLite database is created when this file does not exist.
DB_PATH=./charsibot.db

# Optional server configuration.
PORT=8081
HOST=0.0.0.0
SHUTDOWN_TIMEOUT=30

# Set all four values to enable Twitch chat sending.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_USER_ID=
TWITCH_CHANNEL_USER_ID=

# Required only when using the OAuth pages.
TWITCH_OAUTH_REDIRECT_URI=
