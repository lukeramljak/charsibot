{
  "name": "twitch-overlay",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && vite build --config vite.server.config.ts",
    "start": "node build/server.js",
    "preview": "node build/server.js",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check",
    "check:watch": "svelte-kit sync && svelte-check --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "go run ../cmd/openapi > openapi.json && openapi-typescript openapi.json -o src/lib/api.generated.ts && prettier --write openapi.json src/lib/api.generated.ts",
    "check:api": "pnpm generate:api && git diff --exit-code -- openapi.json src/lib/api.generated.ts",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint ."
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.4",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.19.17",
    "@types/ws": "8.18.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "svelte": "5.56.8",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.4",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "better-sqlite3": "13.0.2",
    "openapi-fetch": "^0.17.0",
    "valibot": "1.4.2",
    "ws": "8.21.1"
  }
}
